// Master window with sidebar + content router and Advanced Security Access Matrix Control Layer
import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, SchemaAction } from "theme.slint";

import { GpfFinalPaymentView, GpfCaseDetails } from "views/gpf.slint";
import { VlcsComputerizedView } from "views/vlcs.slint";
import { PenDakView } from "views/pendak.slint";
import { PensionView, PensionDetailsSlint, PensionStatusSlint,} from "views/pension.slint";
import { ConfirmButton } from "components/confirm_button.slint";
import { AnimatedToast } from "components/toast.slint";
import { SecurityLogo } from "components/animated_logo.slint";
import { FluidButton } from "components/fluid_button.slint";

import { LoginView, RegisterFormFields } from "views/login.slint";
import { Sidebar } from "components/sidebar.slint";
import { TopBar } from "components/topbar.slint";


component Avatar inherits Rectangle {
    in property <string> username: "G";
    in property <image> avatar_source;
    in property <bool> has_avatar: false;
    callback clicked();
    width: 90px;
    height: 90px;
    border-radius: 45px;
    background: Theme.bg-sidebar;
    border-width: 2px;
    border-color: Theme.brand-primary;
    clip: true;
    if (!has_avatar): Text {
        text: username == "" ? "U" : username;
        font-size: 40px;
        font-weight: 900;
        color: Theme.brand-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if (has_avatar): Image {
        source: avatar_source;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
    Rectangle {
        background: #00000099;
        opacity: av_ta.has-hover ? 1.0 : 0.0;
        VerticalLayout {
            alignment: center;
            Text {
                text: "📷";
                font-size: 24px;
                horizontal-alignment: center;
            }

            Text {
                text: "Update";
                font-size: 10px;
                font-weight: 800;
                color: white;
                horizontal-alignment: center;
            }
        }
    }

    av_ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PremiumSchemaCard inherits Rectangle {
    in property <image> lucide_icon;
    in property <string> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> node_ip;
    in property <bool> has_access;
    in property <bool> active;
    callback clicked();

    height: 120px;
    horizontal-stretch: 1;
    border-radius: 16px;
    background: !root.has_access
        ? Theme.bg-card-hover
        : (root.active
            ? (Theme.is-light-mode ? #00E5FF26 : #00E5FF1F)
            : (ta.has-hover ? Theme.bg-card-hover : Theme.bg-card));
    border-width: 1.5px;
    border-color: !root.has_access
        ? Theme.border-color
        : (root.active
            ? Theme.brand-primary
            : (ta.has-hover ? #00E5FF66 : Theme.border-color));
    opacity: root.has_access ? 1.0 : 0.5;
    drop-shadow-blur: ta.has-hover ? 20px : 0px;
    drop-shadow-color: #00E5FF14;

    animate background { duration: 200ms; }
    animate border-color { duration: 200ms; }

    HorizontalLayout {
        padding: 24px;
        spacing: 20px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 12px;
                background: !root.has_access
                    ? Theme.bg-card-hover
                    : (root.active ? Theme.brand-primary : (Theme.is-light-mode ? #00E5FF26 : #00E5FF1A));
                Image {
                    source: root.lucide_icon;
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    colorize: root.has_access && !root.active ? Theme.brand-primary : (root.active ? Theme.bg-main : Theme.text-muted);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: root.title;
                    font-size: 16px;
                    font-weight: 800;
                    color: root.has_access ? Theme.text-primary : Theme.text-muted;
                }

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: !root.has_access ? Theme.brand-danger : Theme.brand-success;
                }
            }

            Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.text-secondary;
            }

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: "NODE CLUSTER: " + root.node_ip;
                    font-size: 11px;
                    font-family: "monospace";
                    color: Theme.text-muted;
                }

                Text {
                    text: !root.has_access ? "RESTRICTED" : (root.active ? "MATRIX ROUTING ENGAGED" : "ONLINE STABLE");
                    font-size: 10px;
                    font-weight: 900;
                    color: !root.has_access ? Theme.brand-danger : (root.active ? Theme.brand-primary : Theme.brand-success);
                    letter-spacing: 0.5px;
                }
            }
        }
    }

    ta := TouchArea {
        clicked => { if (root.has_access) { root.clicked(); } }
    }
}

component ToggleAccessCheckbox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    height: 32px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 4px;
            border-width: 1.5px;
            border-color: root.checked ? Theme.brand-primary : #475569;
            background: root.checked ? #00E5FF1F : transparent;
            y: 7px;
            if (root.checked): Image {
                source: @image-url("assets/check.svg");
                width: 12px;
                height: 12px;
                colorize: Theme.brand-primary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}

export struct UserData {
    username: string,
    role: string,
    last_login: string,
    full_name: string,
    designation: string,
    expires_at: string,
    allowed_schemas: string
}
export struct SchemaAccessState {
    gpffp: bool,
    vlcs: bool,
    agtall: bool,
    agdak: bool,
    sai_agartala: bool,
    pendak: bool,
    penindex: bool
}
export struct AuditLogUiData { timestamp: string, operator_id: string, operation_action: string, level: string }

export component AppWindow inherits Window {
    title: "IronVault Command Center";
    preferred-width: 1600px;
    preferred-height: 1000px;
    min-width: 1200px;
    min-height: 800px;
    background: Theme.bg-main;
    icon: @image-url("assets/ironvault.ico");

    in-out property <bool> sidebar_collapsed: false;
    in-out property <string> hwid_string: "HWID: UNKNOWN";
    in property <string> app_version_meta: "v1.0.0";
    in-out property <bool> is_logged_in: false;
    in-out property <string> current_user_name: "GUEST";
    in-out property <string> current_user_role: "UNAUTHORIZED";
    in-out property <string> current_user_full_name: "Unknown Operator";
    in-out property <string> current_user_designation: "Unassigned";
    in-out property <string> current_user_expires: "Never";
    in-out property <string> current_user_schemas_string: "None";
    in-out property <SchemaAccessState> schema_access;
    in-out property <string> auth_screen_state: "landing";
    in-out property <string> active_tab: "overview";    
    in-out property <string> login_error: "";
    in-out property <string> form_user: "";
    in-out property <string> form_pass: "";    
    in-out property <image> current_avatar_image;
    in-out property <bool> current_avatar_loaded: false;
    in-out property <RegisterFormFields> registration_fields;
    in-out property <string> pending_notification_name: "NONE";
    in-out property <string> polling_error_msg: "";
    in-out property <[UserData]> active_users_list: [];
    in-out property <string> op_target_schema: "none";
    in-out property <string> active_schema_action: "none";
    in-out property <string> op_status_msg: "";
    in-out property <bool> op_is_error: false;
    in-out property <string> reveal_secret_value: "";
    in-out property <string> reveal_secret_label: "";
    in-out property <bool> reveal_secret_visible: false;
    in-out property <[UserData]> pending_users_list: [];
    in-out property <bool> show_welcome_popup: false;
    in-out property <bool> forced_password_reset_state: false;
    in-out property <string> form_new_pass: "";
    in-out property <string> form_confirm_pass: "";
    in-out property <string> password_reset_error: "";
    in-out property <string> lease_target_user: "";
    in-out property <string> lease_target_role: "Operator";
    in-out property <string> lease_target_days: "30";
    in-out property <string> lease_target_schemas: "";
    in-out property <bool> cb_gpf: false;
    in-out property <bool> cb_vlcs: false;
    in-out property <bool> cb_sai: false;
    in-out property <bool> cb_dak: false;
    in-out property <[AuditLogUiData]> dashboard_audit_stream: [];
    in-out property <string> op_regd_no: "";
    in-out property <string> op_series_id: "";
    in-out property <string> op_account_no: "";
    in-out property <string> op_holder_name: "";
    in-out property <bool> gpf_case_found: false;
    in-out property <GpfCaseDetails> active_gpf_case;
    in-out property <string> op_gpf_new_status: "";
    in-out property <string> vlcs_ddo_code: "";
    in-out property <string> vlcs_emp_code: "";
    in-out property <string> vlcs_emp_mobile: "";
    in-out property <string> entry_app_num: "";
    in-out property <string> entry_letter_no: "";
    in-out property <string> entry_section: "";
    in-out property <string> entry_subject: "";
    in-out property <string> entry_no_of_copies: "1";
    in-out property <string> find_app_num: "";
    in-out property <string> edit_app_num: "";
    in-out property <string> edit_section: "";
    in-out property <string> edit_subject: "";
    in-out property <string> letter_app_num: "";
    in-out property <string> letter_letter_no: "";
    in-out property <string> letter_section: "";
    in-out property <string> letter_subject: "";
    in-out property <string> letter_no_of_copies: "1";
    in-out property <string> dak_ppo: "";
    in-out property <string> dak_fppo: "";
    in-out property <string> dak_gpo: "";
    in-out property <string> dak_cpo: "";
    in-out property <string> dak_adr_1: "";
    in-out property <string> dak_bar_1: "";
    in-out property <string> dak_sent_1: "REGISTERED";
    in-out property <string> dak_sb_1: "YES";
    in-out property <string> dak_adr_2: "";
    in-out property <string> dak_bar_2: "";
    in-out property <string> dak_sent_2: "REGISTERED";
    in-out property <string> dak_sb_2: "YES";
    in-out property <string> dak_adr_3: "";
    in-out property <string> dak_bar_3: "";
    in-out property <string> dak_sent_3: "REGISTERED";
    in-out property <string> dak_sb_3: "YES";
    in-out property <bool> dak_case_found: false;
    in-out property <string> view_dak_letter: "";
    in-out property <string> view_dak_subject: "";
    in-out property <string> view_dak_section: "";
    in-out property <string> dak_corr_date: "";
    in-out property <string> sai_search_query: "";
    in-out property <bool> sai_data_found: false;
    in-out property <[PensionDetailsSlint]> sai_biographical_list: [];
    in-out property <PensionStatusSlint> sai_status_record;
    in-out property <int> idle_timeout_minutes: 10;
    in-out property <int> idle_seconds_elapsed: 0;
    in-out property <string> new_idle_timeout_input: "10";
    in-out property <bool> step_up_visible: false;
    in-out property <string> step_up_action: "";
    in-out property <string> step_up_target: "";
    in-out property <string> step_up_extra: "";
    in-out property <string> step_up_password: "";
    in-out property <string> step_up_error: "";
    in-out property <bool> update_available: false;
    in-out property <bool> update_mandatory: false;
    in-out property <string> update_latest_version: "";
    in-out property <string> update_changelog: "";
    in-out property <string> update_download_url: "";
    in-out property <string> login_success: "";
    // --- GPF Busy Indicators ---
    in-out property <bool> gpf_find_busy: false;
    in-out property <bool> gpf_drop_busy: false;
    in-out property <bool> gpf_purge_busy: false;
    in-out property <bool> gpf_flush_busy: false;
    in-out property <bool> gpf_auth_drop_busy: false;

    // --- VLCS Busy Indicators ---
    in-out property <bool> vlcs_get_ddo_busy: false;
    in-out property <bool> vlcs_update_ddo_busy: false;
    in-out property <bool> vlcs_get_emp_busy: false;
    in-out property <bool> vlcs_update_emp_busy: false;

    // --- DAK Busy Indicators ---
    in-out property <bool> dak_submit_busy: false;
    in-out property <bool> dak_find_busy: false;
    in-out property <bool> dak_update_busy: false;
    in-out property <bool> dak_letter_busy: false;

    // --- SAI Pension Busy Indicator ---
    in-out property <bool> sai_query_busy: false;

    // --- Application Update Notice Properties & Callbacks ---
    // in-out property <bool> update_available: false;
    // in-out property <bool> update_mandatory: false;
    // in-out property <string> update_latest_version: "";
    // in-out property <string> update_changelog: "";
    // in-out property <string> update_download_url: "";

    callback request_dismiss_update_notice(string);
    callback request_open_download_url();
    callback request_step_up(string, string, string);
    callback submit_step_up_reauth(string);
    callback user_activity_detected();
    callback request_idle_timeout_fetch();
    callback commit_idle_timeout(int);
    callback request_authentication(string, string);
    callback request_registration(string, string, string, string, string, string, string);
    callback approve_pending_operator(string, string);
    callback deny_pending_operator(string);
    callback request_logout();
    callback load_users_list();
    callback request_profile_pic_update();
    callback commit_user_settings_pass(string, string, string, bool, bool, bool, bool);
    callback ban_user(string);    
    callback request_find_gpf_case(string);
    callback request_delete_full_case(string, string, string);
    callback request_delete_application(string);
    callback request_delete_precalc(string);
    callback request_update_gpf_status(string, string);
    callback request_delete_auth_reports(string);
    callback request_vlcs_get_ddo(string);
    callback request_vlcs_update_ddo(string);
    callback request_vlcs_get_emp(string);
    callback request_vlcs_update_emp(string, string);
    callback request_find_pension_dak_meta(string);
    callback request_submit_outward_dak();
    callback property_changed_schemas(string);
    callback request_find_outward_dak(string);
    callback request_update_outward_dak();
    callback request_submit_correspondence();
    callback request_pension_details(string);
    callback request_pension_status(string);
    callback reset_user_password(string);
    callback commit_forced_password_update(string, string);
    callback load_pending_users_list();
    callback request_hwid_unblock(string);    
    callback request_checkbox_states_fetch(string);
    callback trigger_log_stream_reload();


    // Idle-timeout tracking: ticks every second while logged in; any
        // user_activity_detected() call (wired to clicks/keys below) resets
        // the counter. Reaching the configured threshold triggers a forced
        // logout — separate from a normal manual logout so it can show a
        // distinct "session expired" message rather than silently landing
        // back on the login screen.
        idle_timer := Timer {
            interval: 1s;
            running: root.is_logged_in;
            triggered => {
                root.idle_seconds_elapsed += 1;
                if (root.idle_seconds_elapsed >= root.idle_timeout_minutes * 60) {
                    root.idle_seconds_elapsed = 0;
                    root.request_logout();
                    root.login_error = "Session expired due to inactivity. Please log in again.";
                }
            }
        }

        // Catches any click anywhere in the window to reset the idle clock.
        // Placed as a low-z-order full-window TouchArea so it doesn't
        // intercept clicks meant for buttons above it (Slint TouchAreas
        // don't block clicks from reaching elements drawn on top).
        TouchArea {
            clicked => { root.idle_seconds_elapsed = 0; }
            moved => { root.idle_seconds_elapsed = 0; }
        }

    Rectangle {
        HorizontalLayout {
            padding: 0px;
            spacing: 0px;
            if (root.is_logged_in): Sidebar {
                collapsed <=> root.sidebar_collapsed;
                active_tab: root.active_tab;
                app_version: root.app_version_meta;
                is_super_admin: root.current_user_role == "SuperAdmin";
                navigate(tab) => {
                    root.active_tab = tab;
                    if (tab == "audit_logs") { root.trigger_log_stream_reload(); }
                    if (tab == "users") { root.load_users_list(); }
                    if (tab == "approvals") { root.load_pending_users_list(); }
                    if (tab == "operations") { root.op_status_msg = ""; }
                    if (tab == "settings") { root.request_idle_timeout_fetch(); }
                }
                toggle_collapsed => { root.sidebar_collapsed = !root.sidebar_collapsed; }
            }

           if (!root.is_logged_in): LoginView {
                horizontal-stretch: 1;
                form_user <=> root.form_user;
                form_pass <=> root.form_pass;
                login_error <=> root.login_error;
                login_success <=> root.login_success;
                registration_fields <=> root.registration_fields;
                login_requested(u, p) => { root.request_authentication(u, p); }
                registration_requested(u, s, f, m, l, d, sec) => { root.request_registration(u, s, f, m, l, d, sec); }
            }

            if (root.is_logged_in): Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-main;
                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;
                    TopBar {
                        page_title: root.active_tab == "overview" ? "COMMAND NODE OVERVIEW" : (root.active_tab == "audit_logs" ? "SYSTEM SECURITY FORENSICS LEDGER" : (root.active_tab == "operations" ? "DYNAMIC OPERATIONS ENGINE MATRIX" : "SECURITY CONTROLS ACCESS MANAGEMENT"));
                        user_full_name: root.current_user_full_name;
                        user_role: root.current_user_role;
                        user_name: root.current_user_name;
                        avatar_source: root.current_avatar_image;
                        has_avatar: root.current_avatar_loaded;
                        toggle_theme => { Theme.is-light-mode = !Theme.is-light-mode; }
                        logout => { root.request_logout(); }
                    }

                    VerticalLayout {
                        padding-left: 40px;
                        padding-right: 40px;
                        padding-top: 40px;
                        padding-bottom: 20px;
                        vertical-stretch: 1;

                        if (root.active_tab == "overview"): VerticalLayout {
                            spacing: 20px;
                            vertical-stretch: 1;
                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                drop-shadow-blur: 15px;
                                drop-shadow-color: #0000004D;
                                height: 140px;
                                HorizontalLayout {
                                    padding: 24px;
                                    spacing: 25px;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Avatar {
                                            username: root.current_user_name;
                                            avatar_source: root.current_avatar_image;
                                            has_avatar: root.current_avatar_loaded;
                                            clicked => { root.request_profile_pic_update(); }
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        width: 250px;
                                        Text {
                                            text: root.current_user_full_name;
                                            font-size: 22px;
                                            font-weight: 900;
                                            color: Theme.brand-primary;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: root.current_user_designation;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: Theme.text-secondary;
                                        }

                                        Text {
                                            text: "ID: @" + root.current_user_name;
                                            font-size: 13px;
                                            font-weight: 800;
                                            color: Theme.brand-warning;
                                        }
                                    }

                                    Rectangle {
                                        width: 1px;
                                        background: Theme.border-color;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 12px;
                                        width: 180px;
                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: "AUTHORITY CLASS";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: Theme.text-muted;
                                            }

                                            Text {
                                                text: root.current_user_role;
                                                font-size: 15px;
                                                font-weight: 800;
                                                color: Theme.text-primary;
                                            }
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            Text {
                                                text: "LEASE EXPIRATION";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: Theme.text-muted;
                                            }

                                            Text {
                                                text: root.current_user_expires;
                                                font-size: 15px;
                                                font-weight: 800;
                                                color: Theme.brand-success;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 1px;
                                        background: Theme.border-color;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        width: 340px;
                                        Text {
                                            text: "AUTHORIZED SCHEMAS";
                                            font-size: 10px;
                                            font-weight: 800;
                                            color: Theme.text-muted;
                                        }

                                        Text {
                                            text: root.current_user_schemas_string;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: Theme.brand-primary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                vertical-stretch: 1;
                            }
                        }
                        if (root.active_tab == "settings"): VerticalLayout {
                            spacing: 20px;
                            Text { text: "SYSTEM CONFIGURATION"; font-size: 32px; font-weight: 800; color: Theme.text-primary; }

                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: 16px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                VerticalLayout {
                                    padding: 28px;
                                    spacing: 16px;

                                    Text { text: "SESSION IDLE TIMEOUT"; font-size: 13px; font-weight: 900; color: Theme.brand-primary; letter-spacing: 1px; }
                                    Text {
                                        text: "Operators are automatically logged out after this many minutes of inactivity. Applies to all accounts, including SuperAdmin sessions.";
                                        font-size: 12px;
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                    }

                                    HorizontalLayout {
                                        spacing: 12px;
                                        alignment: start;
                                        VerticalLayout {
                                            spacing: 4px;
                                            width: 160px;
                                            Text { text: "MINUTES (1-240)"; font-size: 10px; font-weight: 800; color: Theme.text-muted; }
                                            LineEdit { text <=> root.new_idle_timeout_input; height: Theme.input-height; }
                                        }
                                        VerticalLayout {
                                            alignment: end;
                                            Button {
                                                text: "Apply";
                                                height: Theme.input-height;
                                                 clicked => {
                                                    root.request_step_up("idle_timeout", "", root.new_idle_timeout_input);
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Current active setting: " + root.idle_timeout_minutes + " minutes";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Theme.brand-success;
                                    }
                                }
                            }
                        }

                        if (root.active_tab == "audit_logs"): VerticalLayout {
                            spacing: 14px;
                            vertical-stretch: 1;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "🛡️ IMMUTABLE SYSTEM FORENSICS RUNTIME LEDGER ARCHIVE";
                                    font-size: 13px;
                                    font-weight: 900;
                                    color: Theme.text-muted;
                                    letter-spacing: 0.5px;
                                }

                                Rectangle {
                                    width: 110px;
                                    height: 26px;
                                    background: #00E5FF1C;
                                    border-radius: 4px;
                                    Text {
                                        text: "🔄 Force Reload";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: Theme.brand-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        clicked => { root.trigger_log_stream_reload(); }
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.bg-sidebar;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding: 20px;
                                    // FIXED LAYOUT CONFIGURATION: LOCKED HEADER FIXED COLUMNS
                                    HorizontalLayout {
                                        spacing: 0;

                                        padding-left: 14px;
                                        padding-right: 14px;
                                        padding-bottom: 10px;

                                        Text {
                                            width: 220px;
                                            text: "TIMESTAMP TIMELINE";
                                            font-size: 12px;
                                            font-weight: 900;
                                            color: Theme.brand-primary;
                                            horizontal-alignment: left;
                                        }

                                        Text {
                                            width: 140px;
                                            text: "OPERATOR ID NODE";
                                            font-size: 12px;
                                            font-weight: 900;
                                            color: Theme.brand-primary;
                                            horizontal-alignment: left;
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: "AUTHENTICATED FORENSICS OPERATION ACTION DESCRIPTION";
                                            font-size: 12px;
                                            font-weight: 900;
                                            color: Theme.brand-primary;
                                            horizontal-alignment: left;
                                        }

                                        Rectangle {
                                            width: 130px;
                                            background: transparent;

                                            Text {
                                                width: parent.width;
                                                height: parent.height;

                                                text: "IMPACT SEVERITY";

                                                font-size: 12px;
                                                font-weight: 900;
                                                color: Theme.brand-primary;

                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 1px;
                                        background: Theme.border-color;
                                        opacity: 0.3;
                                    }

                                    ScrollView {
                                        VerticalLayout {
                                            spacing: 8px;
                                            padding-top: 10px;

                                            if (root.dashboard_audit_stream.length == 0): Rectangle {
                                                height: 50px;

                                                Text {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: "No secure audit tracking logs recorded on node storage rings.";
                                                    font-italic: true;
                                                    font-size: 14px;
                                                    color: Theme.text-muted;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            for log_row in root.dashboard_audit_stream: Rectangle {
                                                height: 42px;

                                                background: #FFFFFF02;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: Theme.border-color;

                                                HorizontalLayout {
                                                    spacing: 0;
                                                    padding-left: 14px;
                                                    padding-right: 14px;

                                                    // Timestamp
                                                    Text {
                                                        width: 220px;
                                                        text: log_row.timestamp;

                                                        font-family: "Consolas";
                                                        font-size: 12px;
                                                        color: Theme.text-secondary;

                                                        vertical-alignment: center;
                                                        horizontal-alignment: left;
                                                    }

                                                    // Operator
                                                    Text {
                                                        width: 140px;
                                                        text: "@" + log_row.operator_id;

                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        color: Theme.brand-warning;

                                                        vertical-alignment: center;
                                                        horizontal-alignment: left;
                                                    }

                                                    // Operation
                                                    Text {
                                                        horizontal-stretch: 1;

                                                        text: log_row.operation_action;

                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        color: Theme.text-primary;

                                                        overflow: elide;

                                                        vertical-alignment: center;
                                                        horizontal-alignment: left;
                                                    }

                                                    // Severity
                                                    Rectangle {
                                                        width: 130px;
                                                        background: transparent;

                                                        Rectangle {
                                                            width: 100px;
                                                            height: 22px;

                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;

                                                            border-radius: 4px;
                                                            border-width: 1px;

                                                            background: log_row.level == "CRITICAL"
                                                                ? #FF33661A
                                                                : #00E5FF1A;

                                                            border-color: log_row.level == "CRITICAL"
                                                                ? Theme.brand-danger
                                                                : Theme.brand-primary;

                                                            Text {
                                                                width: parent.width;
                                                                height: parent.height;

                                                                text: log_row.level;

                                                                font-size: 11px;
                                                                font-weight: 900;

                                                                color: parent.border-color;

                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if (root.active_tab == "operations"): VerticalLayout {
                            spacing: 24px;
                            HorizontalLayout {
                                alignment: LayoutAlignment.start;
                                spacing: 16px;
                                if (root.op_target_schema != "none"): Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: back_ta.has-hover ? #00E5FF22 : #FFFFFF0A;
                                    border-width: 1px;
                                    border-color: back_ta.has-hover ? Theme.brand-primary : Theme.border-color;
                                    Text {
                                        text: "←";
                                        font-size: 18px;
                                        font-weight: 900;
                                        color: Theme.brand-primary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    back_ta := TouchArea {
                                        clicked => { root.op_target_schema = "none"; root.active_schema_action = "none"; root.op_status_msg = ""; }
                                    }
                                }
                                Text {
                                    text: root.op_target_schema == "none" ? "Multi-Node Matrix Routing Ledger" : (root.op_target_schema == "gpffp" ? "GPF Final Payment System" : (root.op_target_schema == "vlcs" ? "Voucher Level Computerize System" : (root.op_target_schema == "sai_agartala" ? "P-SAI Core Pension Subsystem" : "Pension DAK System")));
                                    font-size: 30px;
                                    font-weight: 900;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                }
                            }

                            ScrollView {
                                width: 100%;
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 32px;
                                    padding-bottom: 40px;

                                    if (root.op_target_schema == "none"): VerticalLayout {
                                        spacing: 28px;
                                        VerticalLayout {
                                            spacing: 14px;
                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: LayoutAlignment.start;
                                                Rectangle {
                                                    width: 4px;
                                                    height: 16px;
                                                    background: Theme.brand-primary;
                                                    border-radius: 2px;
                                                    y: 2px;
