import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BusyButton } from "../components/busy_button.slint";

export component VlcsComputerizedView inherits Rectangle {
    in-out property <string> active_schema_action;
    in-out property <string> op_status_msg;
    in-out property <bool> op_is_error;

    in-out property <bool> vlcs_get_ddo_busy: false;
    in-out property <bool> vlcs_update_ddo_busy: false;
    in-out property <bool> vlcs_get_emp_busy: false;
    in-out property <bool> vlcs_update_emp_busy: false;

    in-out property <string> vlcs_ddo_code;
    in-out property <string> vlcs_emp_code;
    in-out property <string> vlcs_emp_mobile;

    callback request_vlcs_get_ddo(string);
    callback request_vlcs_update_ddo(string);
    callback request_vlcs_get_emp(string);
    callback request_vlcs_update_emp(string, string);

    background: transparent;

    VerticalLayout {
        padding: 24px;
        spacing: 24px;

        // ==========================
        // Navigation
        // ==========================
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Button {
                text: "🏢 DDO Operations Console";
                height: 42px;
                clicked => {
                    root.active_schema_action = "vlcs_ddo";
                }
            }

            Button {
                text: "👤 Employee Operations Node";
                height: 42px;
                clicked => {
                    root.active_schema_action = "vlcs_emp";
                }
            }
        }

        Rectangle {
            background: Theme.bg-card;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.border-color;

            VerticalLayout {
                padding: 28px;
                spacing: 24px;

                // ============================================================
                // DDO OPERATIONS
                // ============================================================
                if (root.active_schema_action == "vlcs_ddo") : VerticalLayout {
                    spacing: 20px;

                    Text {
                        text: "DRAWING AND DISBURSING OFFICER REGISTRY CONFIGURATION";
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 1.2px;
                        color: Theme.brand-primary;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        VerticalLayout {
                            width: 320px;
                            spacing: 6px;

                            Text {
                                text: "DDO ALLOCATION CODE";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                letter-spacing: 0.8px;
                            }

                            LineEdit {
                                text <=> root.vlcs_ddo_code;
                                placeholder_text: "e.g. WBGTRD001";
                                height: 48px;
                                font-size: 15px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        BusyButton {
                            text: "QUERY ALLOCATION MATRIX";
                            busy: root.vlcs_get_ddo_busy;

                            clicked => {
                                root.request_vlcs_get_ddo(root.vlcs_ddo_code);
                            }
                        }

                        BusyButton {
                            text: "COMMIT RE-ALLOCATION PASS";
                            busy: root.vlcs_update_ddo_busy;

                            clicked => {
                                root.request_vlcs_update_ddo(root.vlcs_ddo_code);
                            }
                        }
                    }
                }

                // ============================================================
                // EMPLOYEE OPERATIONS
                // ============================================================
                if (root.active_schema_action == "vlcs_emp") : VerticalLayout {
                    spacing: 20px;

                    Text {
                        text: "EMPLOYEE TELEMETRY AND FIELD RECORD METRICS";
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 1.2px;
                        color: Theme.brand-primary;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        VerticalLayout {
                            width: 280px;
                            spacing: 6px;

                            Text {
                                text: "HRMS EMPLOYEE CODE";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                letter-spacing: 0.8px;
                            }

                            LineEdit {
                                text <=> root.vlcs_emp_code;
                                placeholder_text: "e.g. 20241105";
                                height: 48px;
                                font-size: 15px;
                            }
                        }

                        VerticalLayout {
                            width: 280px;
                            spacing: 6px;

                            Text {
                                text: "TARGET TELEPHONE FIELD";
                                font-size: 11px;
                                font-weight: 700;
                                color: Theme.text-muted;
                                letter-spacing: 0.8px;
                            }

                            LineEdit {
                                text <=> root.vlcs_emp_mobile;
                                placeholder_text: "e.g. +91XXXXXXXXXX";
                                height: 48px;
                                font-size: 15px;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;

                        BusyButton {
                            text: "QUERY CORE FIELDS";
                            busy: root.vlcs_get_emp_busy;

                            clicked => {
                                root.request_vlcs_get_emp(root.vlcs_emp_code);
                            }
                        }

                        BusyButton {
                            text: "UPDATE FIELD METRICS";
                            busy: root.vlcs_update_emp_busy;

                            clicked => {
                                root.request_vlcs_update_emp(
                                    root.vlcs_emp_code,
                                    root.vlcs_emp_mobile
                                );
                            }
                        }
                    }
                }
            }
        }
    }
}