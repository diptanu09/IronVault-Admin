import { Button, LineEdit, ScrollView, ComboBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { BusyButton } from "../components/busy_button.slint";

export struct DakRecipientDetail {
    addressee: string,
    barcode: string,
    sent_by: string,
    service_book: string
}

export component PenDakView inherits Rectangle {
    in-out property <string> active_schema_action: "pendak_entry";
    in-out property <string> op_status_msg;
    in-out property <bool> op_is_error;

    in-out property <string> entry_app_num;
    in-out property <string> entry_section;
    in-out property <string> entry_subject;
    in-out property <string> entry_no_of_copies: "1";

    in-out property <string> find_app_num;
    in-out property <string> edit_app_num;
    in-out property <string> edit_section;
    in-out property <string> edit_subject;

    in-out property <string> letter_app_num;
    in-out property <string> letter_letter_no;
    in-out property <string> letter_section;
    in-out property <string> letter_subject;
    in-out property <string> letter_no_of_copies: "1";

    in-out property <string> dak_ppo;
    in-out property <string> dak_fppo;
    in-out property <string> dak_gpo;
    in-out property <string> dak_cpo;

    in-out property <string> dak_adr_1;
    in-out property <string> dak_bar_1;
    in-out property <string> dak_sent_1: "Speed Post";
    in-out property <string> dak_sb_1: "No";

    in-out property <string> dak_adr_2;
    in-out property <string> dak_bar_2;
    in-out property <string> dak_sent_2: "Speed Post";
    in-out property <string> dak_sb_2: "No";

    in-out property <string> dak_adr_3;
    in-out property <string> dak_bar_3;
    in-out property <string> dak_sent_3: "Speed Post";
    in-out property <string> dak_sb_3: "No";

    in-out property <bool> dak_case_found;
    in-out property <string> view_dak_letter;
    in-out property <string> view_dak_subject;
    in-out property <string> view_dak_section;
    in-out property <string> dak_corr_date;

    in-out property <bool> dak_submit_busy: false;
    in-out property <bool> dak_find_busy: false;
    in-out property <bool> dak_update_busy: false;
    in-out property <bool> dak_letter_busy: false;

    callback request_find_pension_dak_meta(string);
    callback request_submit_outward_dak();
    callback request_find_outward_dak(string);
    callback request_update_outward_dak();
    callback request_submit_correspondence();

    background: transparent;

    VerticalLayout {
        spacing: 24px;
        padding: 24px;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            Button {
                text: "📝 Entry Outward Case";
                height: 42px;
                checked: root.active_schema_action == "pendak_entry";
                clicked => { root.active_schema_action = "pendak_entry"; }
            }
            Button {
                text: "🔍 Find Outward Case";
                height: 42px;
                checked: root.active_schema_action == "pendak_find";
                clicked => { root.active_schema_action = "pendak_find"; }
            }
            Button {
                text: "✏️ Edit/Update Outward";
                height: 42px;
                checked: root.active_schema_action == "pendak_edit";
                clicked => { root.active_schema_action = "pendak_edit"; }
            }
            Button {
                text: "🔗 Outward Letter Link";
                height: 42px;
                checked: root.active_schema_action == "pendak_letter";
                clicked => { root.active_schema_action = "pendak_letter"; }
            }
        }

        Rectangle {
            background: Theme.bg-card;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.border-color;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 28px;
                spacing: 24px;

                if (root.active_schema_action == "pendak_entry") : ScrollView {
                    VerticalLayout {
                        spacing: 20px;

                        Text {
                            text: "LOG NEW OUTWARD DAK DIARY ENVELOPE RECORD";
                            font-size: 15px;
                            font-weight: 800;
                            letter-spacing: 1.2px;
                            color: Theme.brand-primary;
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 6px;
                                width: 320px;
                                Text {
                                    text: "APPLICATION NO *";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.brand-primary;
                                }
                                LineEdit {
                                    text <=> root.entry_app_num;
                                    placeholder_text: "e.g. 104250 (Required)";
                                    height: 44px;
                                    font-size: 15px;
                                    edited => { root.request_find_pension_dak_meta(root.entry_app_num); }
                                }
                            }
                        }

                        Rectangle {
                            background: Theme.bg-sidebar;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: Theme.border-color;
                            height: 72px;

                            HorizontalLayout {
                                padding: 16px;
                                spacing: 24px;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "AUTO-FETCHED PPO"; font-size: 10px; color: Theme.text-muted; }
                                    Text {
                                        text: root.dak_ppo == "" ? "Awaiting Input..." : root.dak_ppo;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Theme.brand-primary;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "AUTO-FETCHED FPPO"; font-size: 10px; color: Theme.text-muted; }
                                    Text {
                                        text: root.dak_fppo == "" ? "Awaiting Input..." : root.dak_fppo;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Theme.brand-primary;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "AUTO-FETCHED GPO"; font-size: 10px; color: Theme.text-muted; }
                                    Text {
                                        text: root.dak_gpo == "" ? "N/A" : root.dak_gpo;
                                        font-size: 14px;
                                        color: Theme.brand-primary;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "AUTO-FETCHED CPO"; font-size: 10px; color: Theme.text-muted; }
                                    Text {
                                        text: root.dak_cpo == "" ? "N/A" : root.dak_cpo;
                                        font-size: 14px;
                                        color: Theme.brand-primary;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 6px;
                                width: 280px;
                                Text {
                                    text: "ROUTING SECTION MATRIX *";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.brand-primary;
                                }
                                LineEdit {
                                    text <=> root.entry_section;
                                    placeholder_text: "e.g. Pension-3 (Required)";
                                    height: 44px;
                                    font-size: 15px;
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "COMMUNICATION SUBJECT OVERVIEW *";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.brand-primary;
                                }
                                LineEdit {
                                    text <=> root.entry_subject;
                                    placeholder_text: "Summary of files forwarded... (Required)";
                                    height: 44px;
                                    font-size: 15px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                spacing: 6px;
                                width: 140px;
                                Text {
                                    text: "NO OF COPIES";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: Theme.text-muted;
                                }
                                LineEdit {
                                    text <=> root.entry_no_of_copies;
                                    height: 44px;
                                    font-size: 15px;
                                }
                            }
                        }

                        Text {
                            text: "RECIPIENT FORENSICS DISPATCH PROFILES";
                            font-size: 13px;
                            font-weight: 800;
                            color: Theme.brand-warning;
                        }

                        VerticalLayout {
                            spacing: 14px;

                            Rectangle {
                                background: Theme.bg-card-hover;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                height: 72px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 16px;
                                    alignment: center;

                                    Text { text: "#1"; font-weight: 900; color: Theme.brand-primary; vertical-alignment: center; }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "Addressee Name (Auto-fetched / Editable)"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        LineEdit {
                                            text <=> root.dak_adr_1;
                                            placeholder_text: "Auto-fetching pensioner name...";
                                            height: 36px;
                                        }
                                    }

                                    VerticalLayout {
                                        width: 200px;
                                        spacing: 4px;
                                        Text { text: "Speed Post Barcode"; font-size: 10px; color: Theme.text-secondary; }
                                        LineEdit {
                                            text <=> root.dak_bar_1;
                                            placeholder_text: "Barcode Ref";
                                            height: 36px;
                                        }
                                    }

                                    VerticalLayout {
                                        width: 160px;
                                        spacing: 4px;
                                        Text { text: "Sent By *"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        ComboBox {
                                            model: ["Speed Post", "By Hand", "Registered Post", "Special Messenger"];
                                            current-value <=> root.dak_sent_1;
                                            height: 36px;
                                        }
                                    }

                                    VerticalLayout {
                                        width: 110px;
                                        spacing: 4px;
                                        Text { text: "Service Book *"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        ComboBox {
                                            model: ["No", "Yes"];
                                            current-value <=> root.dak_sb_1;
                                            height: 36px;
                                        }
                                    }
                                }
                            }

                            if (root.entry_no_of_copies == "2" || root.entry_no_of_copies == "3") : Rectangle {
                                background: Theme.bg-card-hover;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                height: 72px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 16px;
                                    alignment: center;

                                    Text { text: "#2"; font-weight: 900; color: Theme.brand-primary; vertical-alignment: center; }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "Addressee Name (Auto-fetched / Editable)"; font-size: 10px; color: Theme.text-secondary; }
                                        LineEdit { text <=> root.dak_adr_2; placeholder_text: "Recipient Addressee 2"; height: 36px; }
                                    }

                                    VerticalLayout {
                                        width: 200px;
                                        spacing: 4px;
                                        Text { text: "Speed Post Barcode"; font-size: 10px; color: Theme.text-secondary; }
                                        LineEdit { text <=> root.dak_bar_2; placeholder_text: "Barcode Ref"; height: 36px; }
                                    }

                                    VerticalLayout {
                                        width: 160px;
                                        spacing: 4px;
                                        Text { text: "Sent By *"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        ComboBox {
                                            model: ["Speed Post", "By Hand", "Registered Post", "Special Messenger"];
                                            current-value <=> root.dak_sent_2;
                                            height: 36px;
                                        }
                                    }

                                    VerticalLayout {
                                        width: 110px;
                                        spacing: 4px;
                                        Text { text: "Service Book *"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        ComboBox {
                                            model: ["No", "Yes"];
                                            current-value <=> root.dak_sb_2;
                                            height: 36px;
                                        }
                                    }
                                }
                            }

                            if (root.entry_no_of_copies == "3") : Rectangle {
                                background: Theme.bg-card-hover;
                                border-radius: 12px;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                height: 72px;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    spacing: 16px;
                                    alignment: center;

                                    Text { text: "#3"; font-weight: 900; color: Theme.brand-primary; vertical-alignment: center; }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;
                                        Text { text: "Addressee Name (Auto-fetched / Editable)"; font-size: 10px; color: Theme.text-secondary; }
                                        LineEdit { text <=> root.dak_adr_3; placeholder_text: "Recipient Addressee 3"; height: 36px; }
                                    }

                                    VerticalLayout {
                                        width: 200px;
                                        spacing: 4px;
                                        Text { text: "Speed Post Barcode"; font-size: 10px; color: Theme.text-secondary; }
                                        LineEdit { text <=> root.dak_bar_3; placeholder_text: "Barcode Ref"; height: 36px; }
                                    }

                                    VerticalLayout {
                                        width: 160px;
                                        spacing: 4px;
                                        Text { text: "Sent By *"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        ComboBox {
                                            model: ["Speed Post", "By Hand", "Registered Post", "Special Messenger"];
                                            current-value <=> root.dak_sent_3;
                                            height: 36px;
                                        }
                                    }

                                    VerticalLayout {
                                        width: 110px;
                                        spacing: 4px;
                                        Text { text: "Service Book *"; font-size: 10px; color: Theme.brand-primary; font-weight: 700; }
                                        ComboBox {
                                            model: ["No", "Yes"];
                                            current-value <=> root.dak_sb_3;
                                            height: 36px;
                                        }
                                    }
                                }
                            }
                        }

                        BusyButton {
                            text: "COMMIT IMMUTABLY TO DIARY RING";
                            busy_text: "Committing...";
                            busy: root.dak_submit_busy;
                            height: 52px;
                            clicked => { root.request_submit_outward_dak(); }
                        }
                    }
                }

                if (root.active_schema_action == "pendak_find") : VerticalLayout {
                    spacing: 20px;

                    Text {
                        text: "QUERY METADATA CORRESPONDENCE TRACKER ARCHIVE";
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 1.2px;
                        color: Theme.brand-primary;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 6px;
                            width: 380px;
                            LineEdit {
                                text <=> root.find_app_num;
                                placeholder_text: "Enter verification app sequence token...";
                                height: 48px;
                                font-size: 15px;
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            BusyButton {
                                text: "LOCATE TRANSACTION";
                                busy_text: "Searching...";
                                busy: root.dak_find_busy;
                                height: 48px;
                                clicked => { root.request_find_outward_dak(root.find_app_num); }
                            }
                        }
                    }

                    if (root.dak_case_found) : Rectangle {
                        background: Theme.bg-sidebar;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border-color;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 18px;

                            Text {
                                text: "MATCHED ENCLAVE CASE ENTRY RECORDS";
                                font-size: 14px;
                                font-weight: 800;
                                color: Theme.brand-warning;
                            }

                            GridLayout {
                                spacing: 16px;
                                Row { Text { text: "Letter Reference Number:"; color: Theme.text-muted; } Text { text: root.view_dak_letter; font-weight: 700; color: Theme.text-primary; } }
                                Row { Text { text: "Handling Department Section:"; color: Theme.text-muted; } Text { text: root.view_dak_section; font-family: "Consolas"; color: Theme.text-primary; } }
                                Row { Text { text: "Correspondence Logging Date:"; color: Theme.text-muted; } Text { text: root.dak_corr_date; color: Theme.text-primary; } }
                                Row { Text { text: "Communication Subject Matter:"; color: Theme.text-muted; } Text { text: root.view_dak_subject; wrap: word-wrap; color: Theme.text-primary; } }
                            }
                        }
                    }
                }

                if (root.active_schema_action == "pendak_edit") : VerticalLayout {
                    spacing: 20px;

                    Text {
                        text: "AMEND EXISTENT OUTWARD DATA COEFFICIENTS";
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 1.2px;
                        color: Theme.brand-primary;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 6px;
                            width: 240px;
                            Text { text: "TARGET APP NO"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.edit_app_num; height: 48px; font-size: 15px; }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            width: 240px;
                            Text { text: "RE-ROUTE NEW SECTION"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.edit_section; height: 48px; font-size: 15px; }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Text { text: "REVISED SUBJECT MATTER"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.edit_subject; height: 48px; font-size: 15px; }
                        }
                    }

                    BusyButton {
                        text: "APPLY AMENDS PASS OVER TARGET RECORD";
                        busy_text: "Applying...";
                        busy: root.dak_update_busy;
                        height: 52px;
                        clicked => { root.request_update_outward_dak(); }
                    }
                }

                if (root.active_schema_action == "pendak_letter") : VerticalLayout {
                    spacing: 20px;

                    Text {
                        text: "LINK INTER-DEPARTMENTAL REPLIES & CORRESPONDENCE";
                        font-size: 15px;
                        font-weight: 800;
                        letter-spacing: 1.2px;
                        color: Theme.brand-primary;
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 6px;
                            width: 260px;
                            Text { text: "PARENT APP NO"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.letter_app_num; height: 48px; font-size: 15px; }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            width: 260px;
                            Text { text: "INCOMING LETTER REFERENCE"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.letter_letter_no; height: 48px; font-size: 15px; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 6px;
                            width: 260px;
                            Text { text: "HANDLING SECTION"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.letter_section; height: 48px; font-size: 15px; }
                        }
                        VerticalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            Text { text: "SUBJECT REMARKS"; font-size: 11px; font-weight: 700; color: Theme.text-muted; }
                            LineEdit { text <=> root.letter_subject; height: 48px; font-size: 15px; }
                        }
                    }

                    BusyButton {
                        text: "LINK CORRESPONDENCE DOCUMENT COMPONENT";
                        busy_text: "Linking...";
                        busy: root.dak_letter_busy;
                        height: 52px;
                        clicked => { root.request_submit_correspondence(); }
                    }
                }
            }
        }
    }
}