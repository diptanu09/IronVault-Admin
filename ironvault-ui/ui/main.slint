                                                        border-radius: 8px;
                                                        border-width: 1px;
                                                        border-color: root.lease_target_user == user.username ? Theme.brand-primary : Theme.border-color;
                                                        height: 70px;
                                                        HorizontalLayout {
                                                            padding: 14px;
                                                            alignment: space-between;
                                                            VerticalLayout {
                                                                spacing: 4px;
                                                                width: 180px;
                                                                Text {
                                                                    text: user.full_name;
                                                                    font-size: 14px;
                                                                    font-weight: 800;
                                                                    color: Theme.text-primary;
                                                                }

                                                                Text {
                                                                    text: "@" + user.username;
                                                                    font-size: 11px;
                                                                    color: Theme.brand-warning;
                                                                    font-weight: 800;
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                alignment: center;
                                                                width: 120px;
                                                                Rectangle {
                                                                    width: 100px;
                                                                    height: 24px;
                                                                    border-radius: 4px;
                                                                    background: user.role == "SuperAdmin" ? #FF33661C : (user.role == "Operator" ? #00E5FF1C : #FFB8001C);
                                                                    border-width: 1px;
                                                                    border-color: user.role == "SuperAdmin" ? Theme.badge-admin : (user.role == "Operator" ? Theme.badge-operator : Theme.badge-pending);
                                                                    Text {
                                                                        text: user.role;
                                                                        font-size: 11px;
                                                                        font-weight: 900;
                                                                        color: parent.border-color;
                                                                        horizontal-alignment: center;
                                                                        vertical-alignment: center;
                                                                    }
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                spacing: 2px;
                                                                width: 150px;
                                                                alignment: center;
                                                                Text {
                                                                    text: "LEASE EXPIRATION";
                                                                    font-size: 9px;
                                                                    color: Theme.text-muted;
                                                                    font-weight: 800;
                                                                }

                                                                Text {
                                                                    text: user.expires_at;
                                                                    font-size: 12px;
                                                                    font-weight: 700;
                                                                    color: Theme.brand-success;
                                                                }
                                                            }

                                                            VerticalLayout {
                                                                alignment: center;
                                                                Button {
                                                                    text: "Select Configuration";
                                                                    height: 32px;
                                                                    icon: @image-url("assets/cog.svg");
                                                                    clicked => {
                                                                        root.lease_target_user = user.username;
                                                                        root.lease_target_role = user.role;
                                                                        root.lease_target_days = "30";
                                                                        root.lease_target_schemas = user.allowed_schemas;
                                                                        root.request_checkbox_states_fetch(user.username);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 12px;
                                    Text {
                                        text: "ENCLAVE SECURITY ACCESS CONTROL OVERRIDES";
                                        font-size: 11px;
                                        font-weight: 900;
                                        color: Theme.text-muted;
                                        letter-spacing: 0.5px;
                                    }

                                    Rectangle {
                                        background: Theme.bg-card;
                                        border-radius: Theme.corner-radius;
                                        border-width: 1px;
                                        border-color: root.lease_target_user != "" ? Theme.brand-warning : Theme.border-color;
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            padding: 24px;
                                            ScrollView {
                                                VerticalLayout {
                                                    spacing: 20px;
                                                    alignment: start;
                                                    if (root.lease_target_user == ""): VerticalLayout {
                                                        alignment: center;
                                                        spacing: 12px;
                                                        height: 350px;
                                                        Text {
                                                            text: "🔒 SECURITY OVERRIDE PANEL LOCKED";
                                                            font-size: 13px;
                                                            font-weight: 900;
                                                            color: Theme.brand-warning;
                                                            horizontal-alignment: TextHorizontalAlignment.center;
                                                        }

                                                        Text {
                                                            text: "Select an operator item from the active database ledger on the left to edit network clearance levels, re-route sections, trigger credential resets, or issue revocations.";
                                                            font-size: 12px;
                                                            color: Theme.text-muted;
                                                            horizontal-alignment: TextHorizontalAlignment.center;
                                                            wrap: word-wrap;
                                                        }
                                                    }

                                                    if (root.lease_target_user != ""): VerticalLayout {
                                                        spacing: 16px;
                                                        HorizontalLayout {
                                                            alignment: LayoutAlignment.space-between;
                                                            Text {
                                                                text: "1. PROFILE METADATA IDENTITY";
                                                                font-size: 11px;
                                                                font-weight: 900;
                                                                color: Theme.brand-primary;
                                                                vertical-alignment: center;
                                                            }

                                                            Rectangle {
                                                                width: 26px;
                                                                height: 26px;
                                                                border-radius: 13px;
                                                                background: close_panel_ta.has-hover ? #FF336622 : transparent;
                                                                Image {
                                                                    source: @image-url("assets/subtract-circle.svg");
                                                                    width: 14px;
                                                                    height: 14px;
                                                                    x: (parent.width - self.width) / 2;
                                                                    y: (parent.height - self.height) / 2;
                                                                    colorize: close_panel_ta.has-hover ? Theme.brand-danger : Theme.text-muted;
                                                                }

                                                                close_panel_ta := TouchArea {
                                                                    clicked => { root.lease_target_user = ""; }
                                                                }
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            spacing: 4px;
                                                            Text {
                                                                text: "TARGET OPERATOR ID TOKEN";
                                                                font-size: 10px;
                                                                font-weight: 800;
                                                                color: Theme.text-muted;
                                                            }

                                                            LineEdit {
                                                                text: "@" + root.lease_target_user;
                                                                enabled: false;
                                                                height: Theme.input-height;
                                                            }
                                                        }

                                                        Rectangle {
                                                            height: 1px;
                                                            background: Theme.border-color;
                                                            opacity: 0.4;
                                                        }

                                                        Text {
                                                            text: "2. WORKSPACE ACCESS PARAMETERS";
                                                            font-size: 11px;
                                                            font-weight: 900;
                                                            color: Theme.brand-primary;
                                                        }

                                                        VerticalLayout {
                                                            spacing: 4px;
                                                            Text {
                                                                text: "SECURITY CLEARANCE CLASS GROUP ROLE";
                                                                font-size: 10px;
                                                                font-weight: 800;
                                                                color: Theme.text-muted;
                                                            }

                                                            LineEdit {
                                                                text <=> root.lease_target_role;
                                                                placeholder_text: "Operator / SuperAdmin";
                                                                height: Theme.input-height;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            spacing: 4px;
                                                            Text {
                                                                text: "LEASE COMPLIANCE VALIDATION RENEWAL INTERVAL (DAYS)";
                                                                font-size: 10px;
                                                                font-weight: 800;
                                                                color: Theme.text-muted;
                                                            }

                                                            LineEdit {
                                                                text <=> root.lease_target_days;
                                                                placeholder_text: "30";
                                                                height: Theme.input-height;
                                                            }
                                                        }

                                                        VerticalLayout {
                                                            spacing: 6px;
                                                            Text {
                                                                text: "ASSIGN GRANULAR SCHEMA MATRIX PRIVILEGES";
                                                                font-size: 10px;
                                                                font-weight: 800;
                                                                color: Theme.text-muted;
                                                            }

                                                            HorizontalLayout {
                                                                spacing: 16px;
                                                                ToggleAccessCheckbox {
                                                                    text: "gpffp (Payments)";
                                                                    checked <=> root.cb_gpf;
                                                                }

                                                                ToggleAccessCheckbox {
                                                                    text: "vlcs (Vouchers)";
                                                                    checked <=> root.cb_vlcs;
                                                                }

                                                                ToggleAccessCheckbox {
                                                                    text: "sai_agartala (P-SAI)";
                                                                    checked <=> root.cb_sai;
                                                                }

                                                                ToggleAccessCheckbox {
                                                                    text: "pendak (DAK Diary)";
                                                                    checked <=> root.cb_dak;
                                                                }
                                                            }
                                                        }

                                                        HorizontalLayout {
                                                            alignment: LayoutAlignment.end;
                                                            spacing: 12px;
                                                            padding-top: 4px;
                                                            FluidButton {
                                                                text: "Save Modification Pass";
                                                                icon_image: @image-url("assets/shield-check-1.svg");
                                                                clicked => {
                                                                    root.request_step_up(
                                                                        "commit_settings",
                                                                        root.lease_target_user,
                                                                        root.lease_target_role + "|" + root.lease_target_days + "|" +
                                                                            (root.cb_gpf ? "1" : "0") + (root.cb_vlcs ? "1" : "0") +
                                                                            (root.cb_sai ? "1" : "0") + (root.cb_dak ? "1" : "0")
                                                                    );
                                                                    root.lease_target_user = "";
                                                                }
                                                            }
                                                        }

                                                        Rectangle {
                                                            height: 1px;
                                                            background: Theme.border-color;
                                                            opacity: 0.4;
                                                        }

                                                        Text {
                                                            text: "3. CRITICAL SECURITY OVERRIDES";
                                                            font-size: 11px;
                                                            font-weight: 900;
                                                            color: Theme.brand-danger;
                                                        }

                                                        HorizontalLayout {
                                                            spacing: 12px;
                                                            alignment: LayoutAlignment.stretch;
                                                            ConfirmButton {
                                                                text: "🔑 Reset One-Time Access Token";
                                                                confirm_text: "Confirm Reset?";
                                                                horizontal-stretch: 1;
                                                                confirmed => { root.request_step_up("reset_token", root.lease_target_user, ""); }
                                                            }

                                                            ConfirmButton {
                                                                text: "🚨 Ban Operator Profile";
                                                                confirm_text: "Confirm Ban?";
                                                                horizontal-stretch: 1;
                                                                confirmed => { root.request_step_up("ban_user", root.lease_target_user, ""); }
                                                            }
                                                        }

                                                        HorizontalLayout {
                                                            padding-top: 4px;
                                                            ConfirmButton {
                                                                text: "🔓 Release Hardware Fingerprint (HWID Unblock)";
                                                                confirm_text: "Confirm Release?";
                                                                button_height: 36px;
                                                                horizontal-stretch: 1;
                                                                confirmed => { root.request_step_up("hwid_unblock", root.lease_target_user, ""); }
                                                            }
                                                        }

                                                        Rectangle {
                                                            height: 8px;
                                                        }

                                                        Rectangle {
                                                            height: 1px;
                                                            background: Theme.border-color;
                                                        }

                                                        HorizontalLayout {
                                                            padding-top: 4px;
                                                            Button {
                                                                icon: @image-url("assets/navigation-left.svg");
                                                                text: "Dismiss Panel Focus Configuration";
                                                                height: 34px;
                                                                horizontal-stretch: 1;
                                                                clicked => { root.lease_target_user = ""; }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if (root.op_status_msg != ""): Rectangle {
                        height: 54px;
                        background: root.op_is_error ? #7F1D1D4A : #064E3B4A;
                        border-width: 1px;
                        border-color: root.op_is_error ? Theme.brand-danger : Theme.brand-success;
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            spacing: 16px;
                            alignment: space-between;
                            Text {
                                text: root.op_status_msg;
                                color: root.op_is_error ? #FCA5A5 : #6EE7B7;
                                font-size: 14px;
                                font-weight: 800;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Dismiss Notification";
                                    height: 30px;
                                    clicked => { root.op_status_msg = ""; }
                                }
                            }
                        }
                    }
                }
            }
        }

        if (root.forced_password_reset_state): Rectangle {
            background: #05070BD9;
            TouchArea { }

            Rectangle {
                width: 460px;
                height: 380px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.bg-card;
                border-radius: 16px;
                border-width: 2px;
                border-color: Theme.brand-warning;
                drop-shadow-blur: 24px;
                drop-shadow-color: #FFB80040;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 32px;
                    spacing: 18px;

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "🛡️ FORCED CREDENTIAL MITIGATION RECOGNIZED";
                            font-size: 11px;
                            font-weight: 900;
                            color: Theme.brand-warning;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: "Your session token was generated via a dynamic administrator one-time reset. You must establish a strong custom master password sequence before terminal initialization.";
                            font-size: 12px;
                            color: Theme.text-secondary;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-color;
                    }

                    VerticalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "NEW MASTER PASSWORD";
                                font-size: 10px;
                                font-weight: 800;
                                color: Theme.text-muted;
                            }

                            LineEdit {
                                text <=> root.form_new_pass;
                                input-type: password;
                                height: Theme.input-height;
                                placeholder_text: "Enter high-entropy sequence";
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "CONFIRM MASTER PASSWORD";
                                font-size: 10px;
                                font-weight: 800;
                                color: Theme.text-muted;
                            }

                            LineEdit {
                                text <=> root.form_confirm_pass;
                                input-type: password;
                                height: Theme.input-height;
                                placeholder_text: "Repeat sequence exactly";
                            }
                        }
                    }

                    if (root.password_reset_error != ""): Text {
                        text: root.password_reset_error;
                        color: Theme.brand-danger;
                        font-size: 12px;
                        font-weight: 800;
                        horizontal-alignment: TextHorizontalAlignment.center;
                    }

                    Button {
                        text: "🔒 Authorize and Update Enclave Key";
                        height: 42px;
                        clicked => {
                            if (root.form_new_pass == "") { root.password_reset_error = "Error: Input cannot be empty."; }
                            else if (root.form_new_pass != root.form_confirm_pass) { root.password_reset_error = "Error: Password confirmation mismatch."; }
                            else { root.commit_forced_password_update(root.current_user_name, root.form_new_pass); }
                        }
                    }
                }
            }
        }

        if (root.show_welcome_popup): Rectangle {
            background: #000000B3;
            TouchArea { }

            Rectangle {
                width: 420px;
                height: 240px;
                background: Theme.bg-card;
                border-radius: 16px;
                border-width: 2px;
                border-color: Theme.brand-primary;
                VerticalLayout {
                    padding: 30px;
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "🔒 SECURE ENCLAVE SESSION ENGAGED";
                            font-size: 11px;
                            font-weight: 900;
                            color: Theme.brand-primary;
                            horizontal-alignment: center;
                            letter-spacing: 1px;
                        }

                        Text {
                            text: "Welcome, " + root.current_user_full_name;
                            font-size: 20px;
                            font-weight: 800;
                            color: Theme.text-primary;
                            horizontal-alignment: TextHorizontalAlignment.center;
                        }

                        Text {
                            text: "Clearance Class: " + root.current_user_role;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.brand-warning;
                            horizontal-alignment: TextHorizontalAlignment.center;
                        }
                    }

                    Button {
                        text: "Enter Command Console Node";
                        height: 40px;
                        clicked => { root.show_welcome_popup = false; }
                    }
                }
            }
        }
        if (root.update_available): Rectangle {
            background: #000000D9;
            // Only block interaction entirely if this update is mandatory —
            // optional updates let the operator dismiss and keep working.
            if (root.update_mandatory): TouchArea { }

            Rectangle {
                width: 460px;
                height: 340px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.bg-card;
                border-radius: 16px;
                border-width: 2px;
                border-color: root.update_mandatory ? Theme.brand-danger : Theme.brand-primary;
                VerticalLayout {
                    padding: 28px;
                    spacing: 14px;

                    Text {
                        text: root.update_mandatory ? "⚠ REQUIRED UPDATE AVAILABLE" : "UPDATE AVAILABLE";
                        font-size: 13px;
                        font-weight: 900;
                        color: root.update_mandatory ? Theme.brand-danger : Theme.brand-primary;
                        horizontal-alignment: center;
                        letter-spacing: 0.5px;
                    }

                    Text {
                        text: "Version " + root.update_latest_version + " is now available.";
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: 1px; background: Theme.border-color; }

                    ScrollView {
                        vertical-stretch: 1;
                        Text {
                            text: root.update_changelog;
                            font-size: 12px;
                            color: Theme.text-secondary;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        if (!root.update_mandatory): Button {
                            text: "Remind Me Later";
                            height: 38px;
                            horizontal-stretch: 1;
                            clicked => { root.update_available = false; }
                        }
                        Button {
                            text: "Download Update";
                            height: 38px;
                            horizontal-stretch: 1;
                            clicked => { root.request_open_download_url(); }
                        }
                        Button {
                            text: "Remind Me Later";
                            height: 38px;
                            horizontal-stretch: 1;
                            clicked => {
                                root.update_available = false;
                                root.request_dismiss_update_notice(root.update_latest_version);
                            }
                        }
                    }
                }
            }
        }
        if (root.step_up_visible): Rectangle {
            background: #000000D9;
            TouchArea { }

            Rectangle {
                width: 420px;
                height: 260px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Theme.bg-card;
                border-radius: 16px;
                border-width: 2px;
                border-color: Theme.brand-danger;
                VerticalLayout {
                    padding: 30px;
                    spacing: 16px;

                    Text {
                        text: "🔐 STEP-UP VERIFICATION REQUIRED";
                        font-size: 12px;
                        font-weight: 900;
                        color: Theme.brand-danger;
                        horizontal-alignment: center;
                        letter-spacing: 0.5px;
                    }

                    Text {
                        text: "This is a SuperAdmin-critical action. Re-enter your password to confirm.";
                        font-size: 12px;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    LineEdit {
                        text <=> root.step_up_password;
                        input-type: password;
                        placeholder_text: "Your password";
                        height: Theme.input-height;
                    }

                    if (root.step_up_error != ""): Text {
                        text: root.step_up_error;
                        color: Theme.brand-danger;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Button {
                            text: "Cancel";
                            height: 38px;
                            horizontal-stretch: 1;
                            clicked => {
                                root.step_up_visible = false;
                                root.step_up_password = "";
                                root.step_up_error = "";
                            }
                        }
                        Button {
                            text: "Confirm";
                            height: 38px;
                            horizontal-stretch: 1;
                            clicked => { root.submit_step_up_reauth(root.step_up_password); }
                        }
                    }
                }
            }
        }
    }
}
